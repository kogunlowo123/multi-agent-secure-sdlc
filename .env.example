# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure AI Search
AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_AI_SEARCH_KEY=your-search-key-here
AZURE_AI_SEARCH_INDEX=secure-sdlc-index

# PostgreSQL (pgvector)
DATABASE_URL=postgresql://sdlc_user:password@localhost:5432/secure_sdlc
PGVECTOR_ENABLED=true

# Azure Service Bus
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://your-ns.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key

# Azure Key Vault
AZURE_KEY_VAULT_URL=https://your-kv.vault.azure.net/

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Semgrep
SEMGREP_APP_TOKEN=
SEMGREP_TIMEOUT=120

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=multi-agent-secure-sdlc

# Redis (session/rate-limit cache)
REDIS_URL=redis://localhost:6379/0
